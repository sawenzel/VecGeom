<?xml version="1.0"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
  <define>
    <position name="SCL_PGON_1inTOPpos" x="0" y="0" z="0" unit="cm"/>
  </define>
  <materials>
    <material name="Al" Z="13">
      <D unit="g/cm3" value="2.7000000000000002"/>
      <atom unit="g/mole" value="26.98"/>
    </material>
  </materials>
  <solids>
    <box name="TOP" x="300" y="300" z="200" lunit="cm"/>
    <polyhedra name="pgon" startphi="315" deltaphi="270" numsides="4" aunit="deg" lunit="cm">
      <zplane z="-70" rmin="45" rmax="50"/>
      <zplane z="0" rmin="35" rmax="40"/>
      <zplane z="0" rmin="30" rmax="35"/>
      <zplane z="70" rmin="90" rmax="100"/>
    </polyhedra>
    <scaledSolid name="scaled_pgon">
      <solidref ref="pgon"/>
      <scale name="scaled_pgonscl" x="1" y="1" z="-1"/>
    </scaledSolid>
  </solids>
  <structure>
    <volume name="SCL_PGON">
      <materialref ref="Al"/>
      <solidref ref="scaled_pgon"/>
    </volume>
    <volume name="TOP">
      <materialref ref="Al"/>
      <solidref ref="TOP"/>
      <physvol name="SCL_PGON_1" copynumber="1">
        <volumeref ref="SCL_PGON"/>
        <positionref ref="SCL_PGON_1inTOPpos"/>
      </physvol>
    </volume>
  </structure>
  <setup name="default" version="1.0">
    <world ref="TOP"/>
  </setup>
</gdml>
