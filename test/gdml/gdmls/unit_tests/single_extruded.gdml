<?xml version="1.0"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
  <define>
    <position name="XTRU_1inTOPpos" x="0" y="0" z="0" unit="cm"/>
  </define>
  <materials>
    <material name="Al" Z="13">
      <D unit="g/cm3" value="2.7000000000000002"/>
      <atom unit="g/mole" value="26.98"/>
    </material>
  </materials>
  <solids>
    <box name="TOP" x="200" y="200" z="200" lunit="cm"/>
    <xtru name="XTRU0x1" lunit="cm">
      <twoDimVertex x="-60" y="-30"/>
      <twoDimVertex x="-60" y="30"/>
      <twoDimVertex x="60" y="30"/>
      <twoDimVertex x="60" y="-30"/>
      <twoDimVertex x="55" y="-30"/>
      <twoDimVertex x="55" y="25"/>
      <twoDimVertex x="50" y="25"/>
      <twoDimVertex x="45" y="20"/>
      <twoDimVertex x="40" y="25"/>
      <twoDimVertex x="30" y="25"/>
      <twoDimVertex x="25" y="5"/>
      <twoDimVertex x="-5" y="0"/>
      <twoDimVertex x="-5" y="10"/>
      <twoDimVertex x="0" y="5"/>
      <twoDimVertex x="0" y="25"/>
      <twoDimVertex x="-30" y="25"/>
      <twoDimVertex x="-30" y="20"/>
      <twoDimVertex x="-40" y="20"/>
      <twoDimVertex x="-40" y="10"/>
      <twoDimVertex x="-30" y="10"/>
      <twoDimVertex x="-30" y="-30"/>
      <section zOrder="0" zPosition="-40" xOffset="0" yOffset="0" scalingFactor="1"/>
      <section zOrder="1" zPosition="-40" xOffset="0" yOffset="0" scalingFactor="1"/>
      <section zOrder="2" zPosition="-40" xOffset="0" yOffset="0" scalingFactor="1"/>
      <section zOrder="3" zPosition="40" xOffset="0" yOffset="0" scalingFactor="1"/>
    </xtru>
  </solids>
  <structure>
    <volume name="XTRU">
      <materialref ref="Al"/>
      <solidref ref="XTRU0x1"/>
    </volume>
    <volume name="TOP">
      <materialref ref="Al"/>
      <solidref ref="TOP"/>
      <physvol name="XTRU_1" copynumber="1">
        <volumeref ref="XTRU"/>
        <positionref ref="XTRU_1inTOPpos"/>
      </physvol>
    </volume>
  </structure>
  <setup name="default" version="1.0">
    <world ref="TOP"/>
  </setup>
</gdml>
