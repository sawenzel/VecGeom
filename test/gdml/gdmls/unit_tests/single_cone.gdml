<?xml version="1.0"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
  <define>
    <position name="CONE_1inTOPpos" x="0" y="0" z="0" unit="cm"/>
  </define>
  <materials>
    <material name="Al" Z="13">
      <D unit="g/cm3" value="2.7000000000000002"/>
      <atom unit="g/mole" value="26.98"/>
    </material>
  </materials>
  <solids>
    <box name="TOP" x="200" y="200" z="200" lunit="cm"/>
    <cone name="CONE0x1" z="80" rmin1="10" rmin2="35" rmax1="20" rmax2="45" startphi="0" deltaphi="360" aunit="deg" lunit="cm"/>
  </solids>
  <structure>
    <volume name="CONE">
      <materialref ref="Al"/>
      <solidref ref="CONE0x1"/>
    </volume>
    <volume name="TOP">
      <materialref ref="Al"/>
      <solidref ref="TOP"/>
      <physvol name="CONE_1" copynumber="1">
        <volumeref ref="CONE"/>
        <positionref ref="CONE_1inTOPpos"/>
      </physvol>
    </volume>
  </structure>
  <setup name="default" version="1.0">
    <world ref="TOP"/>
  </setup>
</gdml>
