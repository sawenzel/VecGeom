<?xml version="1.0"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
  <define>
    <position name="Trap_1inTOPpos" x="0" y="0" z="0" unit="cm"/>
  </define>
  <materials>
    <material name="Al" Z="13">
      <D unit="g/cm3" value="2.7000000000000002"/>
      <atom unit="g/mole" value="26.98"/>
    </material>
  </materials>
  <solids>
    <box name="TOP" x="200" y="200" z="200" lunit="cm"/>
    <trap name="Trap0x1" z="60" theta="15" phi="30" x1="20" x2="30" x3="20" x4="30" y1="40" y2="40" alpha1="0" alpha2="0" aunit="deg" lunit="cm"/>
  </solids>
  <structure>
    <volume name="Trap">
      <materialref ref="Al"/>
      <solidref ref="Trap0x1"/>
    </volume>
    <volume name="TOP">
      <materialref ref="Al"/>
      <solidref ref="TOP"/>
      <physvol name="Trap_1" copynumber="1">
        <volumeref ref="Trap"/>
        <positionref ref="Trap_1inTOPpos"/>
      </physvol>
    </volume>
  </structure>
  <setup name="default" version="1.0">
    <world ref="TOP"/>
  </setup>
</gdml>
