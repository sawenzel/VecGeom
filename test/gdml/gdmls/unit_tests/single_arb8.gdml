<?xml version="1.0"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
  <define>
    <position name="ARB8_1inTOPpos" x="0" y="0" z="0" unit="cm"/>
  </define>
  <materials>
    <material name="Al" Z="13">
      <D unit="g/cm3" value="2.7000000000000002"/>
      <atom unit="g/mole" value="26.98"/>
    </material>
  </materials>
  <solids>
    <box name="TOP" x="200" y="200" z="200" lunit="cm"/>
    <arb8 name="TGeoArb8" v1x="-30" v1y="-25" v2x="-25" v2y="25" v3x="5" v3y="25" v4x="25" v4y="-25" v5x="-28" v5y="-23" v6x="-23" v6y="27" v7x="-23" v7y="27" v8x="13" v8y="-27" dz="20" lunit="cm"/>
  </solids>
  <structure>
    <volume name="ARB8">
      <materialref ref="Al"/>
      <solidref ref="TGeoArb8"/>
    </volume>
    <volume name="TOP">
      <materialref ref="Al"/>
      <solidref ref="TOP"/>
      <physvol name="ARB8_1" copynumber="1">
        <volumeref ref="ARB8"/>
        <positionref ref="ARB8_1inTOPpos"/>
      </physvol>
    </volume>
  </structure>
  <setup name="default" version="1.0">
    <world ref="TOP"/>
  </setup>
</gdml>
