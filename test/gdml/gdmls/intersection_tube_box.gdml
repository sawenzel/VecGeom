<?xml version="1.0"?>
<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
  <define>
    <position name="COMP4_1inTOPpos" x="0" y="0" z="0" unit="cm"/>
  </define>
  <materials>
    <material name="Al" Z="13">
      <D unit="g/cm3" value="2.7000000000000002"/>
      <atom unit="g/mole" value="26.98"/>
    </material>
  </materials>
  <solids>
    <box name="TOP" x="200" y="200" z="200" lunit="cm"/>
    <tube name="tube1" rmin="1" rmax="15" z="30" startphi="30" deltaphi="240" aunit="deg" lunit="cm"/>
    <box name="box1" x="10" y="10" z="10" lunit="cm"/>
    <intersection name="mir">
      <first ref="tube1"/>
      <second ref="box1"/>
    </intersection>
  </solids>
  <structure>
    <volume name="COMP4">
      <materialref ref="Al"/>
      <solidref ref="mir"/>
    </volume>
    <volume name="TOP">
      <materialref ref="Al"/>
      <solidref ref="TOP"/>
      <physvol name="COMP4_1" copynumber="1">
        <volumeref ref="COMP4"/>
        <positionref ref="COMP4_1inTOPpos"/>
      </physvol>
    </volume>
  </structure>
  <setup name="default" version="1.0">
    <world ref="TOP"/>
  </setup>
</gdml>
